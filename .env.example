# ---- Server ----
PORT=8080

# ---- Agent model ----
# Default model (shown first in the UI). Provider is inferred from the model id.
LLM_MODEL=deepseek-v4-pro

# OpenAI-compatible providers (DeepSeek is OpenAI-compatible)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Local Ollama (no key required)
OLLAMA_BASE=http://localhost:11434

# ---- Server-side voice (TTS) ----
# google = keyless Google Translate TTS (default) | openai = OpenAI TTS | mock = disable server TTS (browser fallback)
TTS_PROVIDER=google

# Only used when TTS_PROVIDER=openai
TTS_API_BASE=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
